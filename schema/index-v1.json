{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.astra.app/schema/index-v1.json",
  "title": "astra.registry.index/1",
  "description": "registry/v1/index.json — the catalogue the Astra client fetches. GENERATED from plugins/**; never hand-edited. Two audiences share one file: the daemon's current reader, which knows only the flat fields (id/name/version/description/platform_downloads), and everything from Phase 2.9 on, which reads `releases[]` for the per-artifact sha256 and size. The flat fields are a projection of `releases[0]`, produced by the same generator run, so they cannot disagree with it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "serial", "plugins"],
  "properties": {
    "$comment": { "type": "string" },
    "schema": { "const": "astra.registry.index/1" },
    "serial": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic. Derived from the commit count of `main`, never read-and-incremented from a file — two merges landing at once would collide on that. The daemon refuses an index whose serial went backwards (PRODUCTION_PLAN §3.2)."
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities", "description", "download_url", "downloads", "icon_url",
        "id", "license", "name", "platform_downloads", "releases",
        "repository_url", "source", "stars", "updated_at", "version"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": {
          "type": "string",
          "description": "The latest listed release. Compatibility projection of releases[0].version."
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "The one-line card text. Projection of plugin.json's `summary`; named `description` because that is the field the daemon already deserialises."
        },
        "details": { "type": "string", "maxLength": 4000 },
        "author": { "type": "string", "maxLength": 64 },
        "author_url": { "type": "string", "pattern": "^https://" },
        "license": { "type": "string", "maxLength": 64 },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "keywords": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "homepage": { "type": "string", "pattern": "^https://" },
        "repository_url": { "type": "string", "pattern": "^https://github\\.com/" },
        "icon_url": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "downloads": { "type": "integer", "minimum": 0, "description": "Always 0. This registry counts nothing; see README §What is not here." },
        "stars": { "type": "integer", "minimum": 0, "description": "Always 0, same reason." },
        "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "added_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "staging": {
          "type": "boolean",
          "description": "true when the latest listed release has no artifact digest yet. Such an entry is deliberately absent from `platform_downloads` and `download_url`, so a client that only knows the flat fields cannot download it."
        },
        "download_url": {
          "type": "string",
          "description": "Legacy platform-agnostic URL. Empty except for a `noarch` release, which has genuinely one artifact for every host."
        },
        "platform_downloads": {
          "type": "object",
          "description": "Compatibility projection: platform key -> URL for the latest listed release. A `noarch` artifact is written under every supported platform key (PRODUCTION_PLAN §5.2), so no client needs to learn the word. Digest-free (staging) releases are omitted entirely.",
          "propertyNames": { "$ref": "#/$defs/platformKey" },
          "additionalProperties": { "type": "string", "pattern": "^https://" }
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "description": "Newest first, by semver precedence. This is the authoritative half of the record.",
          "items": { "$ref": "#/$defs/release" }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "published_at", "release", "artifacts"],
      "properties": {
        "version": { "type": "string" },
        "published_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "protocol": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "min_astra_version": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "permissions": { "type": "object", "additionalProperties": true },
        "changelog_url": { "type": "string", "pattern": "^https://" },
        "staging": { "type": "boolean" },
        "staging_reason": { "type": "string" },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "description": "Copied through from the version file. `github_release` names a repo and a tag; `direct` names the `base_url` its artifacts sit under. schema/version-v1.json says why the second kind exists and where it is allowed.",
          "properties": {
            "kind": { "enum": ["github_release", "direct"] },
            "repo": { "type": "string" },
            "tag": { "type": "string" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "base_url": { "type": "string", "pattern": "^https://" }
          },
          "oneOf": [
            {
              "title": "github_release",
              "properties": { "kind": { "const": "github_release" } },
              "required": ["kind", "repo", "tag"]
            },
            {
              "title": "direct",
              "properties": { "kind": { "const": "direct" } },
              "required": ["kind", "base_url"]
            }
          ]
        },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/platformKey" },
          "additionalProperties": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "filename"],
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?/[^\\s]+$",
          "description": "Any https origin; which one is legal is decided by this release's `release` object and enforced in tools/validate.mjs, not by a pattern that can only describe GitHub."
        },
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.astraplugin$" },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the whole .astraplugin file. Absent only on a staging entry, which is uninstallable by construction."
        },
        "size": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repo"],
      "properties": {
        "kind": { "const": "github" },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        "subdirectory": { "type": "string" }
      }
    },
    "platformKey": {
      "enum": [
        "linux-x64", "windows-x64", "noarch",
        "linux-arm64", "windows-arm64", "macos-x64", "macos-arm64"
      ]
    }
  }
}
