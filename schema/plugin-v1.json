{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.astra.app/schema/plugin-v1.json",
  "title": "astra.registry.plugin/1",
  "description": "plugins/<id>/plugin.json — the version-independent half of a listing. Hand-written, hand-reviewed, one file per plugin. Everything that changes per release lives in versions/<semver>.json instead, so a new release is a new file and never a conflicting edit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "summary", "license", "source", "added_at"],
  "properties": {
    "$comment": { "type": "string" },
    "schema": { "const": "astra.registry.plugin/1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])$",
      "description": "Must equal the containing directory name. Becomes a path component on every user's disk — tools/lib/ids.mjs checks far more than this pattern."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "$comment": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source": { "$ref": "#/$defs/source" },
    "homepage": { "type": "string", "pattern": "^https://" },
    "icon_url": { "type": "string", "pattern": "^https://" },
    "categories": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ai", "audio", "automation", "communication", "development",
          "entertainment", "productivity", "system", "utilities", "voice"
        ]
      }
    },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 -]{0,31}$" }
    },
    "added_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "The day this plugin was first listed. A date, not a timestamp: it is provenance, not telemetry."
    },
    "unlisted": {
      "type": "boolean",
      "description": "true keeps the listing in git and out of the generated index. Used to retire a plugin without deleting its audit trail."
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repo"],
      "description": "Where the bytes come from. The daemon re-derives the expected download URL from this and refuses an artifact URL that does not sit under it (PRODUCTION_PLAN §5.3 A.6), so this field is a security control, not a link.",
      "properties": {
        "$comment": { "type": "string" },
        "kind": { "const": "github" },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        "subdirectory": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
      }
    }
  }
}
